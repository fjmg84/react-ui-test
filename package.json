{
  "name": "@fjmg84/uitest",
  "version": "0.1.0",
  "description": "Zero-config React UI testing library with provider inference and accessibility-first queries",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vitest": {
      "import": "./dist/vitest-integration.js",
      "types": "./dist/vitest-integration.d.ts"
    },
    "./vitest-entry": {
      "import": "./dist/vitest-entry.js",
      "types": "./dist/vitest-entry.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=10.0.0",
    "@testing-library/react": ">=16.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "vitest": ">=2.0.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "happy-dom": "15.11.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "aria-query": "5.3.2"
  }
}
